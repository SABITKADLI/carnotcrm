# Node 24+. Persist this path on a durable volume when deployed.
CRM_DATABASE_PATH=./data/carnot.sqlite
# Required behind a reverse proxy; exact browser origin, no trailing slash.
CRM_PUBLIC_URL=http://localhost:3000
# Demo access is never enabled in NODE_ENV=production.
CRM_DEMO_MODE=false

# Shopify custom app credentials: all values remain server-side.
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PUBLICATION_ID=
SHOPIFY_LOCATION_ID=
SHOPIFY_WEBHOOK_SECRET=

# Purchase-order attachments (private S3 bucket; server-side credentials only).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ATTACHMENTS_PREFIX=carnot/attachments
S3_PRESIGNED_URL_TTL_SECONDS=300
